+pragma Singleton
+
+import QtQuick
+
+/*
+ * Material Design 3 system colour roles.
+ *
+ * The host application may publish Material Design 3 roles through the theme
+ * "extra" map using the "m3_<role>" naming convention, for example
+ * ui.theme.extra["m3_surface_container_high"].
+ *
+ * Every property below returns the published role when it is available and
+ * falls back to the closest legacy theme colour otherwise, so that themes
+ * without Material Design 3 keys keep working unchanged.
+ */
+QtObject {
+    id: root
+
+    readonly property var extra: ui.theme.extra
+
+    function role(name, fallback) {
+        var value = root.extra ? root.extra["m3_" + name] : undefined
+        if (value === undefined || value === null || value === "") {
+            return fallback
+        }
+        return value
+    }
+
+    // Surfaces
+    readonly property color surface: role("surface", ui.theme.backgroundPrimaryColor)
+    readonly property color surfaceDim: role("surface_dim", ui.theme.backgroundSecondaryColor)
+    readonly property color surfaceBright: role("surface_bright", ui.theme.backgroundPrimaryColor)
+    readonly property color surfaceContainerLowest: role("surface_container_lowest", ui.theme.backgroundPrimaryColor)
+    readonly property color surfaceContainerLow: role("surface_container_low", ui.theme.backgroundPrimaryColor)
+    readonly property color surfaceContainer: role("surface_container", ui.theme.backgroundSecondaryColor)
+    readonly property color surfaceContainerHigh: role("surface_container_high", ui.theme.popupBackgroundColor)
+    readonly property color surfaceContainerHighest: role("surface_container_highest", ui.theme.backgroundTertiaryColor)
+    readonly property color onSurface: role("on_surface", ui.theme.fontPrimaryColor)
+    readonly property color onSurfaceVariant: role("on_surface_variant", ui.theme.fontSecondaryColor)
+
+    // Accents
+    readonly property color primary: role("primary", ui.theme.accentColor)
+    readonly property color onPrimary: role("on_primary", ui.theme.backgroundPrimaryColor)
+    readonly property color primaryContainer: role("primary_container", ui.theme.accentColor)
+    readonly property color onPrimaryContainer: role("on_primary_container", ui.theme.fontPrimaryColor)
+    readonly property color secondaryContainer: role("secondary_container", ui.theme.buttonColor)
+    readonly property color onSecondaryContainer: role("on_secondary_container", ui.theme.fontPrimaryColor)
+
+    // Outlines and inverses
+    readonly property color outline: role("outline", ui.theme.strokeColor)
+    readonly property color outlineVariant: role("outline_variant", ui.theme.strokeColor)
+    readonly property color inverseSurface: role("inverse_surface", ui.theme.fontPrimaryColor)
+    readonly property color inverseOnSurface: role("inverse_on_surface", ui.theme.backgroundPrimaryColor)
+
+    // Status
+    readonly property color error: role("error", ui.theme.accentColor)
+    readonly property color onError: role("on_error", ui.theme.backgroundPrimaryColor)
+    readonly property color scrim: role("scrim", "#000000")
+    readonly property color shadow: role("shadow", "#000000")
+
+    // State layer opacities (Material Design 3 state layer specification)
+    readonly property real hoverOpacity: 0.08
+    readonly property real focusOpacity: 0.10
+    readonly property real pressedOpacity: 0.10
+    readonly property real draggedOpacity: 0.16
+    readonly property real disabledContentOpacity: 0.38
+    readonly property real disabledContainerOpacity: 0.12
+
+    // Shape scale
+    readonly property real cornerExtraSmall: 4
+    readonly property real cornerSmall: 8
+    readonly property real cornerMedium: 12
+    readonly property real cornerLarge: 16
+    readonly property real cornerExtraLarge: 28
+
+    // Motion
+    readonly property bool reducedMotion: root.extra ? root.extra["m3_reduced_motion"] === true : false
+
+    readonly property int durationShort4: 200
+    readonly property int durationMedium1: 250
+    readonly property int durationStandard: 150
+
+    //! NOTE Returns 0 when the user asked for reduced motion.
+    function duration(ms) {
+        return root.reducedMotion ? 0 : ms
+    }
+}
