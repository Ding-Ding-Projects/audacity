Subject: [PATCH] Material Design 3 tooltips and scroll bars

Generated by buildscripts/tools/muse_patches.py regenerate.
Applied to the muse submodule working tree at configure time.
---
diff --git a/framework/uicomponents/qml/Muse/UiComponents/StyledScrollBar.qml b/framework/uicomponents/qml/Muse/UiComponents/StyledScrollBar.qml
index cc54e04..5b45d72 100644
--- a/framework/uicomponents/qml/Muse/UiComponents/StyledScrollBar.qml
+++ b/framework/uicomponents/qml/Muse/UiComponents/StyledScrollBar.qml
@@ -22,13 +22,16 @@
 import QtQuick
 import QtQuick.Controls
 
+import Muse.Ui
+
 ScrollBar {
     id: root
 
     property alias color: handle.color
     property alias border: handle.border
 
-    property real thickness: 8
+    //! NOTE Material Design 3 thin scroll bar, expanded while hovered
+    property real thickness: root.hovered ? 8 : 4
     property real minimumSizeInPixels: 30
 
     readonly property bool isVertical: orientation === Qt.Vertical
@@ -45,10 +48,18 @@ ScrollBar {
         implicitHeight: root.thickness
 
         radius: root.thickness / 2
-        color: ui.theme.fontPrimaryColor
+        color: M3Roles.onSurfaceVariant
         opacity: 0.0
         visible: false
 
+        Behavior on implicitWidth {
+            NumberAnimation { duration: M3Roles.duration(M3Roles.durationStandard); easing.type: Easing.OutCubic }
+        }
+
+        Behavior on implicitHeight {
+            NumberAnimation { duration: M3Roles.duration(M3Roles.durationStandard); easing.type: Easing.OutCubic }
+        }
+
         property bool forcedActive: false
 
         states: [
@@ -59,7 +70,7 @@ ScrollBar {
                 PropertyChanges {
                     target: handle
                     visible: true
-                    opacity: root.pressed ? 0.7 : 0.3
+                    opacity: root.pressed ? 0.62 : 0.38
                 }
             }
         ]
@@ -68,12 +79,12 @@ ScrollBar {
             from: "active"
 
             SequentialAnimation {
-                PauseAnimation { duration: 200 }
+                PauseAnimation { duration: M3Roles.duration(200) }
 
                 NumberAnimation {
                     target: handle
                     property: "opacity"
-                    duration: 100
+                    duration: M3Roles.duration(100)
                     to: 0.0
                 }
 
diff --git a/framework/uicomponents/qml/Muse/UiComponents/StyledToolTip.qml b/framework/uicomponents/qml/Muse/UiComponents/StyledToolTip.qml
index 710b8e0..b333afa 100644
--- a/framework/uicomponents/qml/Muse/UiComponents/StyledToolTip.qml
+++ b/framework/uicomponents/qml/Muse/UiComponents/StyledToolTip.qml
@@ -32,6 +32,17 @@ StyledPopupView {
     property alias description: descriptionLabel.text
     property string shortcut: ""
 
+    //! NOTE Material Design 3 distinguishes plain tooltips from rich tooltips
+    readonly property bool isRichToolTip: Boolean(root.description)
+
+    cornerRadius: root.isRichToolTip ? M3Roles.cornerMedium : M3Roles.cornerExtraSmall
+    elevationLevel: root.isRichToolTip ? 2 : 0
+
+    backgroundColor: root.isRichToolTip ? M3Roles.surfaceContainerHigh : M3Roles.inverseSurface
+    borderColor: root.isRichToolTip ? M3Roles.outlineVariant : "transparent"
+
+    readonly property color contentColor: root.isRichToolTip ? M3Roles.onSurface : M3Roles.inverseOnSurface
+
     contentWidth: Math.min(content.implicitWidth, 300 - margins * 2)
     contentHeight: content.implicitHeight
 
@@ -39,7 +50,9 @@ StyledPopupView {
     y: root.parent.height
 
     padding: 8
-    margins: 8
+    //! NOTE 8 by 4 padding for plain tooltips, 12 for rich tooltips
+    margins: root.isRichToolTip ? 12 : 8
+    verticalMargins: root.isRichToolTip ? 12 : 4
 
     openPolicies: PopupView.NoActivateFocus
 
@@ -62,6 +75,7 @@ StyledPopupView {
                 Layout.fillWidth: true
 
                 font: ui.theme.bodyBoldFont
+                color: root.contentColor
                 horizontalAlignment: Text.AlignLeft
                 wrapMode: Text.WordWrap
             }
@@ -70,6 +84,7 @@ StyledPopupView {
                 id: shortcutLabel
 
                 text: "(" + root.shortcut + ")"
+                color: root.contentColor
                 horizontalAlignment: Text.AlignRight
                 opacity: 0.8
 
@@ -81,6 +96,7 @@ StyledPopupView {
             id: descriptionLabel
             Layout.fillWidth: true
 
+            color: root.contentColor
             horizontalAlignment: Text.AlignLeft
             wrapMode: Text.Wrap
 
