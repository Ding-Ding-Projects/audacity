             text: root.text
         }
@@ -82,31 +84,34 @@ StyledTabButton {
         id: backgroundRect
         anchors.fill: root
 
-        color: ui.theme.backgroundSecondaryColor
+        color: root.isCurrent ? M3Roles.surface : M3Roles.surfaceContainer
         opacity: 1
 
-        states: [
-            State {
-                name: "HOVERED"
-                when: root.hovered && !root.isCurrent
-
-                PropertyChanges {
-                    target: backgroundRect
-                    color: ui.theme.backgroundPrimaryColor
-                    opacity: ui.theme.buttonOpacityHover
-                }
-            },
-
-            State {
-                name: "SELECTED"
-                when: root.isCurrent
-
-                PropertyChanges {
-                    target: backgroundRect
-                    color: ui.theme.backgroundPrimaryColor
-                }
+        //! NOTE Material Design 3 state layer
+        Rectangle {
+            anchors.fill: parent
+
+            color: M3Roles.onSurface
+            opacity: root.pressed ? M3Roles.pressedOpacity
+                                  : (root.hovered ? M3Roles.hoverOpacity : 0.0)
+
+            Behavior on opacity {
+                NumberAnimation { duration: M3Roles.duration(M3Roles.durationStandard); easing.type: Easing.OutCubic }
             }
-        ]
+        }
+    }
+
+    //! NOTE Material Design 3 secondary tab indicator
+    Rectangle {
+        anchors.left: root.left
+        anchors.right: root.right
+        anchors.rightMargin: 1
+        anchors.bottom: root.bottom
+
+        height: 2
+
+        visible: root.isCurrent
+        color: M3Roles.primary
     }
 
     Rectangle {
