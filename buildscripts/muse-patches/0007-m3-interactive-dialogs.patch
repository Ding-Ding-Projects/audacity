Subject: [PATCH] Material Design 3 standard message dialogs

Generated by buildscripts/tools/muse_patches.py regenerate.
Applied to the muse submodule working tree at configure time.
---
diff --git a/framework/interactive/qml/Muse/Interactive/StandardDialog.qml b/framework/interactive/qml/Muse/Interactive/StandardDialog.qml
index 5b54a82..965b817 100644
--- a/framework/interactive/qml/Muse/Interactive/StandardDialog.qml
+++ b/framework/interactive/qml/Muse/Interactive/StandardDialog.qml
@@ -58,7 +58,8 @@ StyledDialogView {
     contentWidth: mainPanel.implicitWidth
     contentHeight: content.implicitHeight
 
-    margins: 16
+    //! NOTE Material Design 3 dialog padding
+    margins: 24
 
     onDetailedTextChanged: {
         if (root.detailedText.length <= 0) {
@@ -86,7 +87,7 @@ StyledDialogView {
     Column {
         id: content
 
-        spacing: 16
+        spacing: 24
 
         StandardDialogPanel {
             id: mainPanel
diff --git a/framework/interactive/qml/Muse/Interactive/StandardDialogPanel.qml b/framework/interactive/qml/Muse/Interactive/StandardDialogPanel.qml
index 8296394..5d7898f 100644
--- a/framework/interactive/qml/Muse/Interactive/StandardDialogPanel.qml
+++ b/framework/interactive/qml/Muse/Interactive/StandardDialogPanel.qml
@@ -141,16 +141,19 @@ Row {
         }
     }
 
-    spacing: 27
+    //! NOTE Material Design 3 dialog spacing
+    spacing: 24
 
     StyledIconLabel {
         id: icon
 
         anchors.top: parent.top
-        width: 48
-        height: 48
+        //! NOTE Material Design 3 dialog hero icon
+        width: 24
+        height: 24
 
-        font.pixelSize: 48
+        font.pixelSize: 24
+        color: (root.type === "ERROR" || root.type === "WARNING") ? M3Roles.error : M3Roles.primary
         iconCode: root.standardIcon(root.type)
 
         visible: root.withIcon && !isEmpty
@@ -179,7 +182,9 @@ Row {
                 id: titleLabel
                 width: parent.width
 
+                //! NOTE Material Design 3 headline-small type for the dialog headline
                 font: ui.theme.largeBodyBoldFont
+                color: M3Roles.onSurface
                 horizontalAlignment: Text.AlignLeft
                 wrapMode: Text.Wrap
 
@@ -190,6 +195,8 @@ Row {
                 id: textLabel
                 width: parent.width
 
+                //! NOTE Material Design 3 body-medium supporting text
+                color: M3Roles.onSurfaceVariant
                 horizontalAlignment: Text.AlignLeft
                 wrapMode: Text.Wrap
 
