+    signal regexBuilderRequested()
+
     property NavigationPanel navigation: NavigationPanel {
         name: "ShortcutsTopPanel"
         enabled: root.enabled && root.visible
@@ -101,4 +105,22 @@ RowLayout {
         navigation.panel: root.navigation
         navigation.column: 2
     }
+
+    FlatButton {
+        id: regexButton
+
+        icon: IconCode.BRACKET_PARENTHESES_SQUARE
+        transparent: true
+
+        toolTipTitle: qsTrc("shortcuts", "Build a regular expression")
+
+        navigation.name: "ShortcutSearchRegexBuilder"
