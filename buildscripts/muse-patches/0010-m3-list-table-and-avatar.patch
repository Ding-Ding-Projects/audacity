@@ -22,6 +22,8 @@
 import QtQuick
 import QtQuick.Controls as Controls
 
+import Muse.Ui
+
 Controls.PageIndicator {
     id: root
 
@@ -36,8 +38,9 @@ Controls.PageIndicator {
 
         radius: width / 2
 
-        color: ui.theme.fontPrimaryColor
