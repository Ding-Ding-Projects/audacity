diff --git a/framework/cloud/qml/Muse/Cloud/AccountAvatar.qml b/framework/cloud/qml/Muse/Cloud/AccountAvatar.qml
index 0dbcc4a..c207c0b 100644
--- a/framework/cloud/qml/Muse/Cloud/AccountAvatar.qml
+++ b/framework/cloud/qml/Muse/Cloud/AccountAvatar.qml
@@ -42,10 +42,11 @@ Item {
         id: background
         anchors.fill: parent
 
-        color: ui.theme.backgroundSecondaryColor
+        //! NOTE Material Design 3 surface container and outline roles
